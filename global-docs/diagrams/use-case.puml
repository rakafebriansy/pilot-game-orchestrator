@startuml
!theme mars

left to right direction
actor "Pengguna (Pelajar)" as user

package "Aksara Jawa Translator App" {
  usecase "Menerjemahkan via Kamera (Real-time)" as UC1
  usecase "Menerjemahkan via Foto Galeri" as UC2
  usecase "Melihat Hasil Terjemahan Latin" as UC3
  usecase "Menyalin Teks Hasil" as UC4
  usecase "Menggunakan Aksesibilitas (VoiceOver/Dynamic Type)" as UC5
}

user --> UC1
user --> UC2
user --> UC3
user --> UC4
user --> UC5

UC1 ..> UC3 : include
UC2 ..> UC3 : include

@enduml
